{
  "name": "live-reader",
  "version": "0.5.0",
  "description": "Simple feed reader for Firefox and Chrome, yet another Live Bookmarks.",
  "repository": "https://github.com/taqpan/live-reader",
  "author": "taqpan",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "npm run build:firefox && npm run build:chrome",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "npm run zip:firefox && npm run zip:chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "npm run build:firefox && web-ext lint --source-dir .output/firefox-mv2",
    "test": "vitest run",
    "check": "npm run lint && npm run compile && npm run test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "sass-embedded": "^1.108.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
